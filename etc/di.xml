<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Model\ResourceModel\Db\AbstractDb">
        <plugin name="tonyapps_actionlog_entity_snapshot" type="Tonyapps\ActionLog\Plugin\EntitySnapshotPlugin"/>
    </type>
    <!-- Product, category and customer resource models are EAV and don't extend Db\AbstractDb. -->
    <type name="Magento\Eav\Model\Entity\AbstractEntity">
        <plugin name="tonyapps_actionlog_entity_snapshot" type="Tonyapps\ActionLog\Plugin\EntitySnapshotPlugin"/>
    </type>
    <!-- Structure is heavy and only needed when config is saved; Logger runs on every admin request. -->
    <type name="Tonyapps\ActionLog\Model\Logger">
        <arguments>
            <argument name="configStructure" xsi:type="object">Magento\Config\Model\Config\Structure\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Backend\Model\Auth">
        <plugin name="tonyapps_actionlog_auth_login" type="Tonyapps\ActionLog\Plugin\AuthLoginPlugin"/>
    </type>
    <type name="Magento\Backend\Model\Auth\Session">
        <plugin name="tonyapps_actionlog_session_guard" type="Tonyapps\ActionLog\Plugin\SessionGuardPlugin"/>
    </type>
    <type name="Magento\Config\Model\Config">
        <plugin name="tonyapps_actionlog_config_save" type="Tonyapps\ActionLog\Plugin\ConfigSavePlugin"/>
    </type>

    <virtualType name="Tonyapps\ActionLog\Model\ResourceModel\ActionLog\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">tonyapps_action_log</argument>
            <argument name="resourceModel" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\ActionLog</argument>
        </arguments>
    </virtualType>
    <virtualType name="Tonyapps\ActionLog\Model\ResourceModel\AdminLoginLog\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">tonyapps_admin_login_log</argument>
            <argument name="resourceModel" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\AdminLoginLog</argument>
        </arguments>
    </virtualType>
    <virtualType name="Tonyapps\ActionLog\Model\ResourceModel\AdminSession\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">tonyapps_admin_session</argument>
            <argument name="resourceModel" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\AdminSession</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="tonyapps_actionlog_log_listing_data_source" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\ActionLog\Grid\Collection</item>
                <item name="tonyapps_actionlog_loginlog_listing_data_source" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\AdminLoginLog\Grid\Collection</item>
                <item name="tonyapps_actionlog_session_listing_data_source" xsi:type="string">Tonyapps\ActionLog\Model\ResourceModel\AdminSession\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
